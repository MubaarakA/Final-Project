{
  "name": "employee-management-system",
  "version": "1.0.0",
  "description": "A simple Employee Management System prototype",
  "main": "backend/server.js",
  "scripts": {
    "build:css": "tailwindcss -i ./frontend/css/input.css -o ./frontend/css/output.css --minify",
    "start": "node backend/server.js",
    "test": "echo \"No tests specified\" && exit 0",
    "dev": "concurrently \"tailwindcss -i ./frontend/css/input.css -o ./frontend/css/output.css --watch\" \"nodemon backend/server.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^2.3.0",
    "mysql2": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.19"
  }
}
